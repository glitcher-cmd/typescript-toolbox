{
  "name": "typescript-toolbox",
  "version": "0.1.0",
  "description": "Small, dependency-free TypeScript utilities for modern applications.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": ["typescript", "utilities", "toolbox", "validation", "async"],
  "author": "Kyle Linco",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
